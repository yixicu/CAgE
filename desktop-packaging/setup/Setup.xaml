<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Install Carnot Agent Engine" Width="730" Height="700" MinHeight="570" MinWidth="620" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" Background="#F6F8FB" Foreground="#192D42">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Padding" Value="14,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="#E8EDF3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="shape" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="shape" Property="Opacity" Value=".83"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="shape" Property="Opacity" Value=".48"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="shape" Property="BorderThickness" Value="2"/><Setter TargetName="shape" Property="BorderBrush" Value="#3275B8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#BDCADA"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
 <Style x:Key="Folder" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="Folder"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox Width="19" Height="16"><Path Data="M 2,4 Q 2,2 4,2 L 9,2 11,5 20,5 Q 22,5 22,7 L 22,15 Q 22,17 20,17 L 4,17 Q 2,17 2,15 Z M 3,7 L 21,7" Stroke="#34536D" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox></DataTemplate></Setter.Value></Setter><Setter Property="Width" Value="38"/><Setter Property="Padding" Value="5"/></Style>
</Window.Resources>
<DockPanel LastChildFill="True">
 <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DCE4EB" BorderThickness="0,1,0,0" Padding="28,16"><DockPanel><Button Name="Go" DockPanel.Dock="Right" Background="#174F80" Foreground="White" IsDefault="True" Content="Install Carnot"/><TextBlock Name="Status" Foreground="#445F75" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/></DockPanel></Border>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,24">
 <DockPanel Margin="0,0,0,20"><Image Name="Mark" Width="52" Height="52" Margin="0,0,14,0"/><TextBlock Text="Carnot Agent Engine" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold"/></DockPanel>
 <StackPanel Name="Locations"><Label Target="{Binding ElementName=InstallPath}" Content="Install location" Padding="0,18,0,5" FontWeight="SemiBold"/><DockPanel><Button Name="PickInstall" Style="{StaticResource Folder}" ToolTip="Choose install location" AutomationProperties.Name="Choose install location" DockPanel.Dock="Right"/><TextBox Name="InstallPath"/></DockPanel>
 <Label Target="{Binding ElementName=DataPath}" Content="Research workspace (optional)" Padding="0,12,0,5"/><DockPanel><Button Name="PickData" Style="{StaticResource Folder}" ToolTip="Choose research workspace" AutomationProperties.Name="Choose research workspace" DockPanel.Dock="Right"/><TextBox Name="DataPath" ToolTip="Leave empty to use the default workspace."/></DockPanel></StackPanel>
 <CheckBox Name="Shortcut" Content="Create a desktop shortcut" Margin="0,14,0,0" IsChecked="False"/>
 <Border Margin="0,14,0,0" Padding="14" Background="White" CornerRadius="8" BorderBrush="#DCE4EB" BorderThickness="1"><Expander Name="Advanced" Header="Advanced" IsExpanded="False"><StackPanel Name="Choices" Margin="4,10,0,0">
 <TextBlock Text="Node.js..." FontWeight="SemiBold"/><WrapPanel Margin="0,6,0,2"><RadioButton Name="HaveNode" GroupName="NodeMode" Content="I have one" Margin="0,0,18,0"/><RadioButton Name="NewNode" GroupName="NodeMode" IsChecked="True" Content="Use new one / I don't know what is it"/></WrapPanel>
 <StackPanel Name="NodeRow" Visibility="Collapsed"><Button Name="DetectNode" Content="Detect on this device" HorizontalAlignment="Left" Margin="0,6"/><DockPanel><Button Name="PickNode" DockPanel.Dock="Right" Style="{StaticResource Folder}" ToolTip="Choose Node.js folder" AutomationProperties.Name="Choose Node.js folder"/><ComboBox Name="Node" AutomationProperties.Name="Node.js installation"/></DockPanel><TextBlock Name="NodeResult" TextWrapping="Wrap"/></StackPanel>
 <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="Other dependencies" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Name="Info" Content="ⓘ" Padding="4,0" Margin="4,0,0,0" MinHeight="24" Background="Transparent" AutomationProperties.Name="Required dependency versions" ToolTipService.ShowDuration="60000" ToolTipService.Placement="Top"/></StackPanel>
 <WrapPanel Margin="0,6,0,2"><RadioButton Name="HaveModules" GroupName="ModulesMode" Content="I have one" Margin="0,0,18,0"/><RadioButton Name="NewModules" GroupName="ModulesMode" IsChecked="True" Content="Use new one / I don't know what is it"/></WrapPanel>
 <StackPanel Name="ModulesRow" Visibility="Collapsed"><Button Name="DetectModules" Content="Detect on this device" HorizontalAlignment="Left" Margin="0,6"/><StackPanel Name="PackageRows"/></StackPanel>
 <TextBlock Name="Plan" Foreground="#375875" TextWrapping="Wrap"/><Separator Margin="0,12"/><CheckBox Name="BasicMap" Content="basic physics knowledge map" IsChecked="False"/></StackPanel></Expander></Border>
 <ProgressBar Name="Progress" Height="4" Margin="0,18,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
 </StackPanel></ScrollViewer>
</DockPanel></Window>
